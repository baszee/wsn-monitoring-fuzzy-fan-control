# Konfigurasi Koneksi Database PostgreSQL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://wsn_backend:change_me@localhost:5432/wsn_db

# Sumber data sensor: mock untuk dummy; paket_valid untuk schema.sql M2 terbaru.
# node_readings tetap tersedia hanya untuk kompatibilitas integrasi lama.
SENSOR_SOURCE=mock
# Kosong = semua sesi. Isi sensor agar sesi pengujian jarak/BER tidak dipakai fuzzy.
PAKET_VALID_SESSION_MODES=sensor

# Opsional khusus PostgreSQL: pisahkan tabel WSNova dari tabel penerima.
# Biarkan kosong bila user database belum memiliki izin membuat/memakai schema ini.
APP_DB_SCHEMA=
SOURCE_DB_SCHEMA=public

# Hanya satu backend yang boleh true. Backend teman/dashboard read-only isi false.
WORKER_ENABLED=true

# Node M2 mengirim sekitar tiap 10 detik; 30 detik memberi toleransi jitter.
FRESHNESS_SECONDS=30

# Akun admin. Buat hash dengan: python backend/make_admin_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# true bila dashboard diakses lewat HTTPS; di localhost (HTTP) harus false
COOKIE_SECURE=false

# Aktifkan hanya untuk deployment demo tanpa data sensor sungguhan.
DEMO_MODE=false
DEMO_FEED_INTERVAL_SECONDS=3
