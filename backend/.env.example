# Konfigurasi Koneksi Database PostgreSQL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wsn_db

# Akun admin. Buat hash dengan: python backend/make_admin_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# true bila dashboard diakses lewat HTTPS; di localhost (HTTP) harus false
COOKIE_SECURE=false
