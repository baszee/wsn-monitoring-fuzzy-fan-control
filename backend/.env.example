# Konfigurasi Koneksi Database PostgreSQL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://wsn_backend:change_me@localhost:5432/wsn_db

# Sumber data sensor: mock untuk dummy lama, node_readings untuk tabel M2.
SENSOR_SOURCE=mock
# Node M2 mengirim sekitar tiap 10 detik; 30 detik memberi toleransi jitter.
FRESHNESS_SECONDS=30

# Akun admin. Buat hash dengan: python backend/make_admin_hash.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# true bila dashboard diakses lewat HTTPS; di localhost (HTTP) harus false
COOKIE_SECURE=false

# Aktifkan hanya untuk deployment demo tanpa data sensor sungguhan.
DEMO_MODE=false
DEMO_FEED_INTERVAL_SECONDS=3
